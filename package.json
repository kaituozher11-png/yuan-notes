{
  "name": "yuan-notes",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"node server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "desktop:dev": "electron .",
    "desktop:pack": "npm run build && electron-builder --win dir",
    "desktop:installer": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "express": "^5.1.0",
    "fflate": "^0.8.2",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "mathlive": "^0.111.4",
    "multer": "^2.0.2",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "undici": "^7.30.2",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "vite": "^7.2.0"
  },
  "overrides": {
    "katex": "$katex"
  },
  "build": {
    "appId": "com.yingxing.notes.preview",
    "productName": "源笔记",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "server/wordToPdf.ps1"
    ],
    "files": [
      "dist/**/*",
      "server/**/*",
      "src/aiNoteOutline.js",
      "src/libraryFolders.js",
      "src/assistantProtocol.js",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/icons/app.ico",
      "target": [
        "dir",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
